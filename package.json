{
  "name": "a2ui-term",
  "version": "0.1.0",
  "description": "A live A2UI board next to your coding agents in the terminal, driven from the shell.",
  "keywords": [
    "a2ui",
    "terminal",
    "tui",
    "ink",
    "tmux",
    "agent"
  ],
  "homepage": "https://github.com/KyleKreuter/a2ui-cli#readme",
  "bugs": "https://github.com/KyleKreuter/a2ui-cli/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyleKreuter/a2ui-cli.git"
  },
  "type": "module",
  "bin": {
    "a2ui-term": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tmux": "sh scripts/tmux-smoke.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@a2ui/web_core": "0.15.0",
    "commander": "^15.1.0",
    "env-paths": "^4.0.0",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
